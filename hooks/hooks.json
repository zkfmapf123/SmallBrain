{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/brain.py hook SessionStart" }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/brain.py hook SubagentStart" }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Agent|Task|Bash",
        "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/brain.py hook PreToolUse" }]
      }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/brain.py hook SubagentStop" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/brain.py hook Stop" }] }
    ]
  }
}
